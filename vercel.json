{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/live-ipos",
      "destination": "https://ipo-backend-nugn.onrender.com/api/live-ipos"
    },
    {
      "source": "/api/live-ipos/stream",
      "destination": "https://ipo-backend-nugn.onrender.com/api/live-ipos/stream"
    },
    {
      "source": "/api/:path*",
      "destination": "https://ipo-backend-nugn.onrender.com/api/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ]
}
